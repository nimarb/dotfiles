# read-only-ish
prefix_rule(
  pattern=[
    ["ls"], ["pwd"], ["cat"], ["bat"], ["less"], ["head"], ["tail"],
    ["tree"], ["stat"], ["file"],
    ["grep"], ["rg"], ["ag"],
    ["sg"], ["ast-grep"],
    ["jq"], ["yq"],
    # ["awk"], ["sed"],
    ["find"],
  ],
  decision="allow",
)

# git read-only
prefix_rule(
  pattern=[
    ["git","status"],
    ["git","diff"],
    ["git","show"],
    ["git","log"],
    ["git","grep"],
  ],
  decision="allow",
)

# test/typecheck loops
prefix_rule(
  pattern=[
    ["pnpm","test"], ["pnpm","lint"], ["pnpm","typecheck"],
    ["npm","test"],
    # ["npm","run","test"], ["npm","run","lint"], ["npm","run","typecheck"],
    # ["go","test"], ["go","vet"],
    # ["cargo","test"], ["cargo","check"], ["cargo","clippy"],
    # ["pytest"],
    ["ruff","check"],
    # ["mypy"],
    # ["tsc"],
    ["tsgo"],
    # ["eslint"],
  ],
  decision="allow",
)
prefix_rule(pattern=["/bin/zsh", "-lc", "git diff --name-only origin/main...HEAD | while read f; do if [[ \"$f\" == web/* ]]; then rg -n \"\\bv1\\b|\\bv2\\b|\\bv3\\b|\\bv4\\b\" \"$f\"; fi; done"], decision="allow")
